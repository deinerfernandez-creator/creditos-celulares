
{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer who applies for a credit in Tecnicell Créditos.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cedula": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "cedula", "phone"]
    },
    "Credit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Credit",
      "type": "object",
      "description": "Represents a credit application for a customer.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "imei": { "type": "string" },
        "initialAmount": { "type": "number" },
        "downPayment": { "type": "number" },
        "totalAmount": { "type": "number" },
        "planType": { "type": "number" },
        "installmentAmount": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["activo", "pagado", "bloqueado"] },
        "customerPhoto": { "type": "string", "description": "Base64 string of the customer photo taken during registration." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "deviceModel", "imei", "initialAmount", "downPayment", "status"]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Records a payment made towards a credit.",
      "properties": {
        "id": { "type": "string" },
        "creditId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "staffId": { "type": "string" }
      },
      "required": ["creditId", "amount", "date"]
    },
    "StaffUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StaffUser",
      "type": "object",
      "description": "Internal staff user with specific roles and permissions.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "vendedor"] },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Root collection for all customer profiles."
    },
    "/credits/{creditId}": {
      "schema": "Credit",
      "description": "Root collection for all credit applications."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Global collection for all payments made."
    },
    "/users/{userId}": {
      "schema": "StaffUser",
      "description": "User profiles for staff members including their roles."
    }
  }
}
