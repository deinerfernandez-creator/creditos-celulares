
{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer who applies for a credit in Tecnicell Créditos.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cedula": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "cedula",
        "phone"
      ]
    },
    "Credit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Credit",
      "type": "object",
      "description": "Represents a credit application for a customer.",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "deviceModel": {
          "type": "string"
        },
        "imei": {
          "type": "string"
        },
        "initialAmount": {
          "type": "number",
          "description": "The total price of the device."
        },
        "downPayment": {
          "type": "number",
          "description": "The initial amount paid by the customer."
        },
        "totalAmount": {
          "type": "number",
          "description": "The total amount to be paid in installments after interest."
        },
        "planType": {
          "type": "number"
        },
        "installmentAmount": {
          "type": "number"
        },
        "remainingBalance": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "activo",
            "completado",
            "atrasado"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "customerId",
        "deviceModel",
        "imei",
        "initialAmount",
        "downPayment",
        "status"
      ]
    },
    "StaffUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StaffUser",
      "type": "object",
      "description": "Internal staff user with specific roles and permissions.",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "vendedor"
          ]
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "role"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "schema": {
            "$ref": "#/backend/entities/Customer"
          },
          "description": "Root collection for all customer profiles."
        }
      },
      {
        "path": "/credits/{creditId}",
        "definition": {
          "entityName": "Credit",
          "schema": {
            "$ref": "#/backend/entities/Credit"
          },
          "description": "Root collection for all credit applications."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "StaffUser",
          "schema": {
            "$ref": "#/backend/entities/StaffUser"
          },
          "description": "User profiles for staff members including their roles."
        }
      }
    ]
  }
}
