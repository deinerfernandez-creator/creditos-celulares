rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA MAESTRA: El administrador maestro tiene acceso TOTAL
    match /{document=**} {
      allow read, write: if request.auth != null && 
                          request.auth.token.email == "deinerfernandez@gmail.com";
    }

    // ACCESO PORTAL DE CLIENTES: Lectura pública para búsqueda por Cédula/IMEI
    // El usuario pidió quitar restricciones para que solo ingresen con esos datos
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /credits/{creditId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}