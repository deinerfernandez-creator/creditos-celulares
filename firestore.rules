rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al Administrador Maestro
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email.lowerCase() == "deinerfernandez@gmail.com";
    }

    // ACCESO TOTAL PARA EL ADMINISTRADOR Y LECTURA PÚBLICA PARA EL PORTAL
    // Se permite lectura pública total en todo el sistema para evitar errores de permisos
    // al listar créditos o clientes en el Dashboard y en el Portal de búsqueda.
    match /{document=**} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}