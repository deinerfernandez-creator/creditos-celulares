rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función ultra-simplificada para el Administrador Maestro
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email == "deinerfernandez@gmail.com";
    }

    // Acceso Maestro y Público
    match /{document=**} {
      // Lectura pública para Dashboard y Portal de Clientes
      allow read: if true;
      // Solo el Administrador Maestro puede crear, editar o borrar datos
      allow write: if isMasterAdmin();
    }
  }
}