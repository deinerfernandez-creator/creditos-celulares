/**
 * TECNICELL CRÉDITOS FIRESTORE SECURITY RULES
 * 
 * CORE PHILOSOPHY:
 * This ruleset implements an internal staff-management model. Access is strictly controlled 
 * via a check against the /users collection OR a master admin email.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Checks if the user is a staff member (admin or vendedor).
     * Hardcoded master admin email for bootstrapping and emergency access.
     */
    function isStaff() {
      let isMasterAdmin = request.auth.token.email == 'deinerfernandez@gmail.com';
      let hasStaffRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendedor');
      
      return isSignedIn() && (isMasterAdmin || hasStaffRole);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Root collection for customers.
     */
    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    /**
     * @description Root collection for credits.
     */
    match /credits/{creditId} {
      allow read, write: if isStaff();
    }

    /**
     * @description Root collection for payments.
     */
    match /payments/{paymentId} {
      allow read, write: if isStaff();
    }

    /**
     * @description Root collection for user profiles and roles.
     * Signed in users can read their own profile to verify roles.
     * Staff can manage other users.
     */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}