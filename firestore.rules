rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al Administrador Maestro
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email.lowerCase() == "deinerfernandez@gmail.com";
    }

    // ACCESO TOTAL PARA EL ADMINISTRADOR
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // ACCESO PARA EL PORTAL DE CLIENTES (Según solicitud del usuario)
    // Se permite lectura pública total para facilitar la búsqueda por Cédula/IMEI 
    // sin necesidad de autenticación forzosa en el portal.
    match /customers/{customerId} {
      allow read: if true;
    }

    match /credits/{creditId} {
      allow read: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
    }
  }
}