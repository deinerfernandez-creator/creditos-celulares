rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * @description REGLA DE ACCESO TOTAL (MASTER ADMIN)
     * Si el correo del usuario autenticado es deinerfernandez@gmail.com,
     * se le concede acceso total a CUALQUIER documento en la base de datos.
     * Esta regla tiene prioridad absoluta.
     */
    match /{document=**} {
      allow read, write: if request.auth != null && 
                          request.auth.token.email == "deinerfernandez@gmail.com";
    }

    /**
     * @description REGLAS PARA PERSONAL (STAFF)
     * Para otros usuarios, se verifica si su UID existe en la colección de usuarios habilitados.
     */
    function isAuthorizedStaff() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /customers/{customerId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /credits/{creditId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /payments/{paymentId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAuthorizedStaff();
    }
  }
}