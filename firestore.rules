rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al administrador maestro de forma segura
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email == "deinerfernandez@gmail.com";
    }

    // REGLA GLOBAL DE ADMINISTRADOR: El Administrador Maestro tiene acceso TOTAL e INCONDICIONAL
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // REGLAS PARA EL PORTAL DE CLIENTES (LECTURA PÚBLICA)
    // Se permite la lectura para que los clientes consulten con su Cédula/IMEI
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /credits/{creditId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId);
    }
  }
}