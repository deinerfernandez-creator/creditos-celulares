rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al Administrador Maestro
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email.lowerCase() == "deinerfernandez@gmail.com";
    }

    // ACCESO TOTAL PARA EL ADMINISTRADOR
    // LECTURA PÚBLICA PARA EL PORTAL DE CLIENTES
    // Se permite lectura pública total para que el portal de búsqueda (Cédula + IMEI)
    // funcione sin necesidad de autenticación previa, tal como se solicitó.
    match /{document=**} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}