/**
 * TECNICELL CRÉDITOS - REGLAS DE SEGURIDAD DEFINITIVAS
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA ---

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Determina si el usuario es el Administrador Maestro.
     * Acceso total basado en el correo electrónico del token de autenticación.
     */
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'deinerfernandez@gmail.com';
    }

    /**
     * @description Determina si el usuario es parte del staff autorizado en la DB.
     */
    function isAuthorizedStaff() {
      if (!isSignedIn()) return false;
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && (get(userPath).data.role == 'admin' || get(userPath).data.role == 'vendedor');
    }

    function hasStaffAccess() {
      return isMasterAdmin() || isAuthorizedStaff();
    }

    // --- REGLAS POR COLECCIÓN ---

    // Acceso total para staff a los datos operativos
    match /customers/{customerId} {
      allow read, write: if hasStaffAccess();
    }

    match /credits/{creditId} {
      allow read, write: if hasStaffAccess();
    }

    match /payments/{paymentId} {
      allow read, write: if hasStaffAccess();
    }

    // Los perfiles de usuario pueden ser leídos por cualquiera autenticado, 
    // pero solo el staff puede editarlos.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if hasStaffAccess();
    }
  }
}