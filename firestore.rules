/**
 * TECNICELL CRÉDITOS FIRESTORE SECURITY RULES
 * 
 * CORE PHILOSOPHY:
 * This ruleset implements an internal staff-management model. Access is strictly controlled 
 * via a Database Access Control (DBAC) pattern where the existence of a document in the 
 * /staffRoles collection OR a master admin email authorizes a user.
 * 
 * DATA STRUCTURE:
 * The data is organized into root-level collections: /customers and /credits.
 * 
 * KEY SECURITY DECISIONS:
 * 1. Role-Based Access: All operations require the user to be an authorized staff member.
 * 2. Staff Authorization: Authorization is determined by checking staffRoles OR the master email.
 * 3. Default Deny: All collections are closed by default unless explicitly allowed.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Checks if the user is a staff member.
     * Includes a hardcoded check for the master admin email for bootstrapping.
     */
    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid)) ||
        request.auth.token.email == 'deinerfernandez@gmail.com'
      );
    }

    // --- COLLECTION RULES ---

    /**
     * @description Authorization collection.
     */
    match /staffRoles/{staffUid} {
      allow get: if isSignedIn();
      allow list, write: if false; // Managed via Admin SDK
    }

    /**
     * @description Root collection for customers.
     */
    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    /**
     * @description Root collection for credits.
     */
    match /credits/{creditId} {
      allow read, write: if isStaff();
    }

    /**
     * @description Root collection for general app users/roles.
     */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}