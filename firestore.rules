rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función centralizada para validar al Administrador Maestro
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "deinerfernandez@gmail.com" || 
        request.auth.uid == "XZ8jrnB1LEhCkqv74Lro6O6VW313"
      );
    }

    // REGLA MAESTRA: 
    // 1. Lectura permitida para todos (Portal de Clientes y carga inicial del Dashboard)
    // 2. Escritura permitida únicamente para el administrador principal
    match /{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}