rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al administrador maestro por correo
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email == "deinerfernandez@gmail.com";
    }

    // Acceso Maestro: Si eres el administrador, tienes permiso total en TODO
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Reglas para personal y otros procesos
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isMasterAdmin());
    }

    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /credits/{creditId} {
      allow read, write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
  }
}