rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA DE ORO: El administrador maestro tiene acceso TOTAL e INCONDICIONAL
    // Esto permite que el correo deinerfernandez@gmail.com gestione todo el sistema
    match /{document=**} {
      allow read, write: if request.auth != null && 
                          request.auth.token.email == "deinerfernandez@gmail.com";
    }

    // PORTAL DE CLIENTES: Acceso de lectura público para facilitar la consulta por Cédula/IMEI
    // Se permite la lectura de las colecciones necesarias para el estado de cuenta
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /credits/{creditId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Perfiles de usuario (Staff)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}