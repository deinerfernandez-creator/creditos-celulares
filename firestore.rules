rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * @description REGLA DE ACCESO MAESTRO
     * Otorga acceso total (lectura y escritura) a CUALQUIER documento si:
     * 1. El usuario es el administrador maestro (deinerfernandez@gmail.com)
     * 2. O si el usuario existe en la colección de personal autorizado (/users/)
     */
    match /{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == "deinerfernandez@gmail.com" ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Reglas específicas para mayor claridad (opcional, ya cubiertas por la anterior)
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /credits/{creditId} {
      allow read, write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}