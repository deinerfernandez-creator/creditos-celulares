/**
 * TECNICELL CRÉDITOS FIRESTORE SECURITY RULES
 * 
 * CORE PHILOSOPHY:
 * Acceso basado en roles internos. El administrador maestro tiene acceso total.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * @description Verifica si el usuario es parte del staff.
     * Prioriza al administrador maestro por correo electrónico.
     */
    function isStaff() {
      if (!isSignedIn()) return false;
      
      // Acceso directo para el administrador maestro
      if (request.auth.token.email == 'deinerfernandez@gmail.com') return true;
      
      // Verificación de rol en la colección de usuarios
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && 
             (get(userPath).data.role == 'admin' || get(userPath).data.role == 'vendedor');
    }

    // --- COLLECTION RULES ---

    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    match /credits/{creditId} {
      allow read, write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read, write: if isStaff();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}